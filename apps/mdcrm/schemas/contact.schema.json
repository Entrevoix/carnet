{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://carnet.local/schemas/contact.schema.json",
  "type": "object", "required": ["schema_version", "type", "id", "name", "emails", "phones", "record_status", "verification_status", "source_capture_ids"],
  "properties": {
    "schema_version": { "const": 1 }, "type": { "const": "contact" }, "id": { "type": "string", "pattern": "^con_[0-9A-HJKMNP-TV-Z]{26}$" },
    "name": { "type": "object", "required": ["display", "normalized"], "properties": { "display": { "type": "string", "minLength": 1 }, "given": { "type": "string" }, "family": { "type": "string" }, "normalized": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "title": { "type": "string" },
    "organization": { "type": "object", "required": ["name"], "properties": { "id": { "type": "string", "pattern": "^org_[0-9A-HJKMNP-TV-Z]{26}$" }, "name": { "type": "string" } }, "additionalProperties": false },
    "emails": { "type": "array", "items": { "$ref": "#/$defs/emailValue" } },
    "phones": { "type": "array", "items": { "$ref": "#/$defs/phoneValue" } },
    "websites": { "type": "array", "items": { "type": "string" } },
    "record_status": { "enum": ["active", "superseded", "archived"] }, "verification_status": { "enum": ["unverified", "verified"] },
    "source_capture_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^cap_" }, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "canonical_contact_id": { "type": "string", "pattern": "^con_" },
    "created_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" },
    "provenance": { "type": "array", "items": { "$ref": "https://carnet.local/schemas/common.schema.json#/$defs/provenance" } }, "revision": { "$ref": "https://carnet.local/schemas/common.schema.json#/$defs/revision" }
  }, "additionalProperties": false,
  "$defs": {
    "emailValue": { "type": "object", "required": ["value", "normalized", "status", "source_capture_id"], "properties": {
    "value": { "type": "string" }, "normalized": { "type": "string", "minLength": 1 }, "type": { "type": "string" },
    "status": { "$ref": "https://carnet.local/schemas/common.schema.json#/$defs/factStatus" }, "source_capture_id": { "type": "string", "pattern": "^cap_" }
    }, "additionalProperties": false },
    "phoneValue": { "type": "object", "required": ["display", "normalized", "status", "source_capture_id"], "properties": {
    "display": { "type": "string" }, "normalized": { "type": "string", "minLength": 1 }, "type": { "type": "string" },
    "status": { "$ref": "https://carnet.local/schemas/common.schema.json#/$defs/factStatus" }, "source_capture_id": { "type": "string", "pattern": "^cap_" }
    }, "additionalProperties": false }
  }
}
