{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://carnet.local/schemas/proposed_change.schema.json",
  "type": "object", "required": ["schema_version", "type", "id", "target_id", "target_revision", "changes"],
  "properties": {
    "schema_version": { "const": 1 }, "type": { "const": "proposed_change" }, "id": { "type": "string", "pattern": "^chg_[0-9A-HJKMNP-TV-Z]{26}$" }, "target_id": { "type": "string", "minLength": 1 }, "target_revision": { "type": "integer", "minimum": 1 },
    "changes": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["operation", "path"], "properties": { "operation": { "enum": ["add", "remove", "replace"] }, "path": { "type": "string", "pattern": "^/" }, "value": {}, "old_value": {}, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": false } },
    "created_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" }, "provenance": { "type": "array", "items": { "$ref": "https://carnet.local/schemas/common.schema.json#/$defs/provenance" } }, "revision": { "$ref": "https://carnet.local/schemas/common.schema.json#/$defs/revision" }
  }, "additionalProperties": false
}
